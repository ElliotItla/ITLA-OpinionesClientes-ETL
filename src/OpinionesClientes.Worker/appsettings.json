{
  "ConnectionStrings": {
    "ResenasOrigen": "Server=ELLIOTKLIQUEA\\SQLEXPRESS;Database=ResenasOrigenDB;Trusted_Connection=True;TrustServerCertificate=True;",
    "OpinionesDW": "Server=ELLIOTKLIQUEA\\SQLEXPRESS;Database=OpinionesClientesDW;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Worker": {
    "IntervaloMinutos": 0,
    "CarpetaLogs": "logs"
  },
  "Fuentes": {
    "Csv": {
      "Habilitada": true,
      "Carpeta": "../../data/csv",
      "Archivos": [ "surveys_part1.csv" ]
    },
    "BaseDatos": {
      "Habilitada": true,
      "NombreConexion": "ResenasOrigen",
      "Consulta": "SELECT IdReview, IdCliente, IdProducto, CONVERT(varchar(10), Fecha, 23) AS Fecha, Comentario, Rating FROM dbo.Resenas",
      "TiempoEsperaSegundos": 30
    },
    "Api": {
      "Habilitada": true,
      "UrlBase": "http://localhost:5135/",
      "Endpoint": "api/comentarios",
      "TamanoPagina": 50,
      "MaxReintentos": 3,
      "TiempoEsperaSegundos": 30
    }
  },
  "Staging": {
    "GuardarEnArchivo": true,
    "CarpetaArchivos": "../../data/staging",
    "GuardarEnBaseDatos": true,
    "NombreConexion": "OpinionesDW",
    "Tabla": "stg.Opiniones",
    "TamanoLote": 5000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
